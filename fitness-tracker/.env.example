VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only keys (no VITE_ prefix) for food lookups. All optional — Open Food
# Facts needs no key and is always tried first.
#
# USDA FoodData Central (US branded products): https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your_usda_fooddata_central_key
#
# FatSecret (much better Australian / NZ coverage, barcode + name search).
# Free "Basic" plan at https://platform.fatsecret.com/api/ — create an app to get
# these two values. Note FatSecret may require IP allowlisting; if lookups never
# return fatsecret results, check the IP restrictions in their dashboard.
FATSECRET_CLIENT_ID=your_fatsecret_client_id
FATSECRET_CLIENT_SECRET=your_fatsecret_client_secret
