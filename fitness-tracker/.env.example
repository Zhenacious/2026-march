VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
#
# Database connection string, used only by "npm run migrate" to apply the SQL
# files in supabase/migrations/. Never used by the browser app.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# (prefer the "Session pooler" URI; it works on more networks).
DATABASE_URL=postgresql://postgres:your_password@your_project.supabase.com:5432/postgres
# Server-only keys (no VITE_ prefix) for food lookups. All optional — Open Food
# Facts needs no key and is always tried first.
#
# USDA FoodData Central (US branded products): https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your_usda_fooddata_central_key
#
# FatSecret (much better Australian / NZ coverage, barcode + name search).
# Free "Basic" plan at https://platform.fatsecret.com/api/ — create an app to get
# these two values. Note FatSecret may require IP allowlisting; if lookups never
# return fatsecret results, check the IP restrictions in their dashboard.
FATSECRET_CLIENT_ID=your_fatsecret_client_id
FATSECRET_CLIENT_SECRET=your_fatsecret_client_secret
#
# Claude connector (api/mcp.js) - the read-only MCP server that lets
# Claude pull a user's training and food data. Each user makes their own link
# on the app's Connect to Claude page; the server needs one secret to look
# those links up. Set it in Vercel (Project -> Settings -> Environment
# Variables, Production) and, for local testing, here.
#
# Supabase dashboard -> Project Settings -> API Keys -> service_role (secret).
# SERVER ONLY. Never give this a VITE_ prefix: that would ship it to browsers.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
#
# Optional, local testing only: a key from the Connect to Claude page so
# "npm run test:mcp" can call http://localhost:8787 without a URL argument.
MCP_TEST_KEY=
#
# Time zone used to decide what "today" and "last 7 days" mean (default Pacific/Auckland).
FITTRACK_TZ=Pacific/Auckland
